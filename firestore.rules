rules_version = '2';
// Données réservées aux membres connectés : la Cloud Function `onLoginRequest` vérifie le code
// à 4 chiffres et donne un jeton Firebase Authentication avec le prénom (claim `member`).
// Les Cloud Functions (SDK Admin) ne sont pas concernées par ces règles.
// Non listées, donc inaccessibles depuis l'app : auth_pins, server_state, shopify_auto_sku.
service cloud.firestore {
  match /databases/{database}/documents {
    function isMember(){
      return request.auth != null && request.auth.token.member is string;
    }
    match /app_data/{key} {
      // member-pins : anciens codes, en attente de suppression par la fonction.
      allow read: if isMember() && key != 'member-pins';
      // Copies de Shopify : écrites uniquement par la Cloud Function.
      allow write: if isMember() && !(key in ['shopify-orders', 'shopify-products', 'member-pins']);
    }
    match /stock_items/{variantId} {
      allow read, write: if isMember();
    }
    // Demandes de connexion : l'app en crée une (id au hasard, impossible à deviner),
    // lit la réponse écrite par la fonction, puis l'efface. Pas de liste possible.
    match /login_requests/{id} {
      allow get, delete: if true;
      allow create: if id.size() >= 32
        && request.resource.data.keys().hasOnly(['action', 'member', 'pin', 'create', 'oldPin', 'newPin', 'createdAt'])
        && request.resource.data.action in ['status', 'login', 'changePin']
        && (request.resource.data.action != 'changePin'
            || (isMember() && request.resource.data.member == request.auth.token.member));
    }
    // Jetons de notification : chacun enregistre le sien à son prénom, sans voir ceux des autres.
    match /fcm_tokens/{token} {
      allow create, update: if isMember()
        && request.resource.data.token == token
        && request.resource.data.member == request.auth.token.member;
      allow delete: if isMember() && resource.data.member == request.auth.token.member;
    }
  }
}
